NODE_ENV=development
BUILD_REVISION=local-dev
LOG_LEVEL=info

POSTGRES_DB=worldgraph
POSTGRES_USER=worldgraph_owner
POSTGRES_PASSWORD=worldgraph_owner_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgres://worldgraph_app:worldgraph_app_local_only@localhost:5432/worldgraph
MIGRATION_DATABASE_URL=postgres://worldgraph_owner:worldgraph_owner_local_only@localhost:5432/worldgraph
# Owner-only maintenance connection for audited projection repair. Do not expose to app processes.
OPERATIONS_DATABASE_URL=postgres://worldgraph_owner:worldgraph_owner_local_only@localhost:5432/worldgraph
REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=4000
WEB_PORT=3000
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001
COMMERCE_SCHEDULE_ENABLED=true
COMMERCE_SCHEDULE_BATCH_SIZE=25
COMMERCE_SCHEDULE_RECONCILIATION_INTERVAL_MS=1000
GOVERNANCE_SCHEDULE_ENABLED=true
GOVERNANCE_SCHEDULE_BATCH_SIZE=25
GOVERNANCE_SCHEDULE_RECONCILIATION_INTERVAL_MS=1000
# Restricted tally/recount connection. Supply only to the governance worker, never browser or API clients.
GOVERNANCE_TALLY_DATABASE_URL=postgres://worldgraph_governance_tally:worldgraph_governance_tally_local_only@localhost:5432/worldgraph
GOVERNANCE_CONTESTS_ENABLED=true
GOVERNANCE_VOTING_ENABLED=true
GOVERNANCE_ENACTMENT_ENABLED=true
GOVERNANCE_OVERRIDES_ENABLED=true
GOVERNANCE_TWO_PERSON_CONTROL_ENABLED=false
GOVERNANCE_CONTEST_RATE_LIMIT_PER_HOUR=6
GOVERNANCE_SPONSOR_RATE_LIMIT_PER_MINUTE=20
GOVERNANCE_VOTE_RATE_LIMIT_PER_MINUTE=30
GOVERNANCE_NOMINATION_RATE_LIMIT_PER_MINUTE=10
# Password reauthentication proof lifetime for creator overrides and governance repairs (30-900s).
GOVERNANCE_STEP_UP_TTL_SECONDS=300
API_INTERNAL_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
AUTH_PEPPER=replace-with-at-least-32-random-characters
ENABLE_LOCAL_REGISTRATION=true
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000

DEPENDENCY_TIMEOUT_MS=1500
REQUEST_TIMEOUT_MS=10000
PRIMITIVE_SEMANTIC_PROFILE=disabled
PRIMITIVE_SEMANTIC_CONTRIBUTION_ENABLED=false
PRIMITIVE_EMBEDDING_TIMEOUT_MS=3000
PRIMITIVE_EMBEDDING_COST_BUDGET_MICROUNITS=0
PRIMITIVE_INDEX_MAX_JOBS_PER_RECONCILIATION=25
PRIMITIVE_INDEX_RECONCILIATION_INTERVAL_MS=5000
MANIFEST_GENERATION_ENABLED=true
MANIFEST_GENERATION_PROVIDER=disabled
MANIFEST_GENERATION_PROVIDER_TIMEOUT_MS=8000
MANIFEST_GENERATION_OUTPUT_TOKEN_LIMIT=4096
MANIFEST_GENERATION_DAILY_BUDGET_MICROUNITS=0
MANIFEST_GENERATION_MAX_CONCURRENT_PER_USER=2
MANIFEST_GENERATION_MAX_CONCURRENT_PER_WORLD=1
MANIFEST_GENERATION_RECONCILIATION_INTERVAL_MS=2000
MANIFEST_PROMPT_RETENTION_DAYS=30
COMPILER_ENABLED=true
COMPILER_MAX_ENTITIES=2000
COMPILER_MAX_RELATIONSHIPS=8000
WORLD_COMPILATION_RECONCILIATION_INTERVAL_MS=2000
ECONOMY_TRANSFERS_ENABLED=true
ECONOMY_OFFERS_ENABLED=true
ECONOMY_ISSUANCE_ENABLED=true
ECONOMY_DEBITS_FROZEN=false
# Empty or up to 64 unique comma-separated tax-policy UUIDs.
ECONOMY_DISABLED_TAX_POLICY_IDS=
ECONOMY_TRANSFER_RATE_LIMIT_PER_MINUTE=20
ECONOMY_OFFER_RATE_LIMIT_PER_MINUTE=10
ECONOMY_ISSUANCE_RATE_LIMIT_PER_HOUR=3
ECONOMY_JOBS_ENABLED=true
ECONOMY_LISTINGS_ENABLED=true
ECONOMY_LISTING_RATE_LIMIT_PER_MINUTE=10
ECONOMY_PRODUCTION_ENABLED=true
ECONOMY_PRODUCTION_RATE_LIMIT_PER_MINUTE=10
ECONOMY_PURCHASES_ENABLED=true
ECONOMY_PURCHASE_RATE_LIMIT_PER_MINUTE=20
ECONOMY_WORK_RATE_LIMIT_PER_MINUTE=10
ECONOMY_OFFER_RECONCILIATION_BATCH_SIZE=25
ECONOMY_OFFER_RECONCILIATION_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_LEASE_MS=30000
OUTBOX_MAXIMUM_ATTEMPTS=10
OUTBOX_RECONCILIATION_INTERVAL_MS=1000
SIMULATION_CONTINUOUS_ENABLED=true
SIMULATION_LEASE_MS=30000
SIMULATION_MAXIMUM_ATTEMPTS=3
SIMULATION_MAXIMUM_BACKOFF_MS=5000
SIMULATION_MAXIMUM_WORLDS_PER_RUN=25
SIMULATION_RECONCILIATION_INTERVAL_MS=1000
SIMULATION_RETRY_BASE_MS=250
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_MS=15000
ENABLE_OPERATIONAL_SMOKE=false
OPERATIONS_TOKEN=replace-with-at-least-32-random-characters
OTEL_EXPORTER_OTLP_ENDPOINT=
