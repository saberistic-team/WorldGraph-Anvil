{
  "name": "@worldgraph/catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./harbor-seed": "./src/harbor-seed.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/harbor-seed.ts src/seed.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@worldgraph/contracts": "workspace:*",
    "ajv": "catalog:",
    "ajv-formats": "catalog:"
  },
  "devDependencies": {
    "tsup": "catalog:"
  }
}
