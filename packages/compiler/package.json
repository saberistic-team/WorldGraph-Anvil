{
  "name": "@worldgraph/compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "worldgraph": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
