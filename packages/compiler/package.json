    "@worldgraph/contracts": "workspace:*",
    "@worldgraph/economy": "workspace:*",
    "@worldgraph/governance": "workspace:*",
    "@worldgraph/manifests": "workspace:*"
  },
  "devDependencies": {
    "tsup": "catalog:"
  }
}
