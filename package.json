{
  "name": "worldgraph-anvil",
  "version": "0.1.0",
  "private": true,
  "description": "WorldGraph (Anvil) persistent society platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13 <25",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "turbo run build",
    "bootstrap": "docker compose up --build -d --wait",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm compiler:golden-check && pnpm test:unit && pnpm db:check && pnpm build && pnpm compiler:cli-check",
    "clean": "turbo run clean && rm -rf .turbo coverage playwright-report test-results",
    "compiler:golden-check": "node --import tsx scripts/check-compiler-golden.ts",
    "compiler:cli-check": "node --import tsx scripts/check-compiler-cli.ts",
    "dev": "turbo run dev --parallel",
    "db:check": "pnpm --filter @worldgraph/db migration:check",
    "db:migrate": "pnpm --filter @worldgraph/db migrate",
    "db:seed:primitives": "pnpm --filter @worldgraph/db seed:primitives",
    "economy": "pnpm --filter @worldgraph/db economy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ledger": "pnpm --filter @worldgraph/db ledger",
    "lint": "eslint . --max-warnings 0",
    "outbox": "pnpm --filter @worldgraph/db outbox",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:e2e": "playwright test",
    "test:compose": "node scripts/compose-smoke.mjs",
    "test:compose:browser": "COMPOSE_SMOKE_BROWSER=true node scripts/compose-smoke.mjs",
    "test:integration": "docker build --platform=${POSTGRES_PLATFORM:-linux/amd64} -t worldgraph-postgres:test docker/postgres && vitest run --config vitest.integration.config.ts && pnpm test:m09-upgrade && pnpm test:m10-upgrade",
    "test:m09-upgrade": "WORLDGRAPH_M09_DATABASE_ORIGIN=upgrade vitest run --config vitest.integration.config.ts apps/api/src/economy-commands.integration.test.ts",
    "test:m10-upgrade": "WORLDGRAPH_M10_DATABASE_ORIGIN=upgrade vitest run --config vitest.integration.config.ts apps/worker/src/governance-command-executor.integration.test.ts apps/worker/src/governance-economic-enactment.integration.test.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "turbo run typecheck",
    "reset:local": "docker compose down --volumes --remove-orphans",
    "projection": "pnpm --filter @worldgraph/db projection",
    "verify": "pnpm check && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "@types/node": "22.20.1",
    "eslint": "10.7.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "testcontainers": "12.0.4",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
