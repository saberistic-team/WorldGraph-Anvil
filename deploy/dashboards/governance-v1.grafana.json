{
  "annotations": { "list": [] },
  "description": "Governance command, scheduler, tally, bounded PostgreSQL operational snapshot, inherited outbox and deployment-owned integrity signals. PostgreSQL remains authoritative and secret ballot selections are never telemetry.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "description": "Code-owned panels use bounded OTLP labels. The governance scheduler refreshes its PostgreSQL operational snapshot after successful discovery; shared outbox panels inherit the global outbox worker histograms. Panels marked external require a deployment-owned read-only PostgreSQL or database-audit exporter.",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# Governance v1\nCommands, deterministic schedules, tallies, proposal/election state aggregates and explicit operator actions are visible without exporting voter, choice, world, contest, receipt, result, policy or checksum identities. Snapshot series use only allowlisted `target_kind` and `state`; global outbox panels are shared infrastructure context, not governance attribution. **External** integrity panels remain empty until the deployment loads its reviewed read-only exporter contract.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "Metric provenance and privacy",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Accepted/rejected/failed governance commands grouped only by bounded command type and outcome.",
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (command_type, outcome) (rate(worldgraph_governance_commands_total[$__rate_interval]))",
          "legendFormat": "{{command_type}} · {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Command outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
