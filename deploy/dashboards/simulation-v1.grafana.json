  "panels": [
    {
      "description": "The first two rows use metrics emitted by the simulation worker. The PostgreSQL reconciliation row requires the deployment-owned exporter contract documented in docs/simulation.md.",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "content": "# Deterministic simulation\nWorker panels are backed only by the code-owned low-cardinality OTLP instruments documented in `docs/simulation.md`. Panels marked **external** remain empty until the deployment's read-only PostgreSQL reconciliation exporter publishes the separate four-metric contract. PostgreSQL is authoritative; Redis/BullMQ only wakes reconciliation.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "Metric provenance",
      "type": "text"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Minimum wake availability reported by simulation workers. Zero means automatic wake delivery is degraded; it does not mean PostgreSQL authority is lost.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "Degraded"
                },
                "1": {
                  "color": "green",
                  "text": "Available"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(worldgraph_simulation_wake_available)",
          "instant": true,
          "legendFormat": "wake",
          "range": false,
          "refId": "A"
